# =============================================================================
# Smart EV Route Planner — environment template
# Copy to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# --- Feature flags -----------------------------------------------------------
# When true (or when Volvo keys are missing), telemetry uses the EX30/EX90 mock.
MOCK_MODE=true

# --- Volvo Cars Developer Portal ---------------------------------------------
# Connected Vehicle API v2: https://api.volvocars.com/connected-vehicle/v2
# Energy API v2 (SoC / range): https://api.volvocars.com/energy/v2
VOLVO_PRIMARY_KEY=
VOLVO_VCC_API_KEY=
# OAuth access token (Bearer) for vehicle owner-authorized calls
VOLVO_ACCESS_TOKEN=
# Target vehicle VIN (required for live telemetry)
VOLVO_VIN=

# --- Mapbox ------------------------------------------------------------------
# Public token for Map GL JS + Geocoding (exposed to the browser)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional secret token for server-side Directions (falls back to public token)
MAPBOX_ACCESS_TOKEN=

# --- Open Charge Map ---------------------------------------------------------
# https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_KEY=
